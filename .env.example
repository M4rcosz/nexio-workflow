MONGODB_URI=mongodb://nexio:nexio@localhost:27017/nexio_workflow?authSource=admin
PORT=8080
# O perfil dev liga o GraphiQL e a criacao automatica de indices; fora dele ambos ficam desligados
SPRING_PROFILES_ACTIVE=dev
# GRAPHIQL_ENABLED e opt-in explicito: sem o perfil dev, o padrao e false em qualquer ambiente
GRAPHIQL_ENABLED=true
# Producao (Render): sem SPRING_PROFILES_ACTIVE=dev e sem GRAPHIQL_ENABLED
# MONGODB_URI=<Atlas URI>
# NEXIO_MONGODB_ENSURE_INDEXES=true

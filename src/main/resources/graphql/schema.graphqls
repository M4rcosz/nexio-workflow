scalar DateTime
scalar JSON

# --- QUERIES ---
type Query {
  # limit e offset tem padrao aqui e teto no servidor: PageQuery recusa limit acima de 100, entao
  # nao existe consulta sem recorte. O padrao 20 espelha PageQuery.DEFAULT_LIMIT.
  workflows(limit: Int = 20, offset: Int = 0, enabledOnly: Boolean = false): [WorkflowDefinition!]!
  workflow(id: ID!): WorkflowDefinition
}

# --- MUTATIONS ---
type Mutation {
  createWorkflow(input: CreateWorkflowInput!): WorkflowDefinition!
  updateWorkflow(id: ID!, input: UpdateWorkflowInput!): WorkflowDefinition!
  deleteWorkflow(id: ID!): Boolean!

  # atalhos para o unico campo que a operacao de ligar/desligar precisa: sao o mesmo que
  # updateWorkflow(input: { enabled: ... }), delegam ao mesmo caso de uso e existem porque o
  # cliente que so quer pausar um workflow nao deveria ter que montar um input parcial
  activateWorkflow(id: ID!): WorkflowDefinition!
  deactivateWorkflow(id: ID!): WorkflowDefinition!
}

# As operacoes de execucao -- as queries `executions` e `execution`, a mutation `triggerWorkflow` e
# os tipos `WorkflowExecution` e `ExecutionStep` -- foram removidas deste schema. Elas nao tem
# resolver, e um campo declarado sem DataFetcher devolve null em silencio: publicar isso e publicar
# um contrato que mente para o cliente. Voltam no Sprint 3, junto com os resolvers que as sustentam,
# nas issues #24 (consulta de execucoes) e #26 (disparo de workflow).

# --- TYPES ---
type WorkflowDefinition {
  id: ID!
  name: String!
  description: String
  trigger: TriggerConfig!
  nodes: [WorkflowNode!]!
  # no por onde a execucao comeca; nulo deixa o grafo resolver sozinho o unico no sem aresta de
  # entrada
  startNodeId: String
  enabled: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type TriggerConfig {
  type: TriggerType!
  config: JSON
  # MOCK_EVENT: {} (sem config extra)
  # SCHEDULE:   { "cron": "0 8 * * 1-5" }
}

type WorkflowNode {
  # id do no dentro do workflow; corresponde a WorkflowNode.nodeId no dominio
  id: String!
  type: NodeType!

  # Parametros dos nos HTTP_REQUEST. Sao campos declarados, e nao chaves dentro de `config`, pelo
  # mesmo motivo das arestas logo abaixo: o que nao esta declarado, a validacao nao enxerga. Com
  # `url` declarado o destino e validado contra SSRF na escrita, e nao so no disparo -- ver
  # docs/adr/0003-typed-http-node-fields.md. Sao nulos nos nos CONDITION, que os recusam.
  #
  # `url` e `headers` voltam com os valores sensiveis mascarados: alem das chaves de nome sensivel
  # (Authorization, api-key, token, secret, password, credential, cookie), o valor de `url` tem o
  # userinfo e os parametros de consulta sensiveis mascarados, porque
  # `https://api.exemplo.test/v1?api_key=...` entrega a credencial por dentro de um campo que
  # nenhuma regra de nome pegaria. A redacao vale so para a leitura: o que esta gravado continua
  # intacto e e o que a execucao usa.
  url: String
  method: HttpMethod
  headers: JSON
  body: JSON

  # Condicao avaliada pelos nos CONDITION; nula nos demais, que a recusam. Declarada e nao guardada
  # em `config` porque o dominio precisa valida-la na escrita, e nao valida o que nao ve --
  # ver docs/adr/0002-spel-sandbox.md.
  #
  # O objeto raiz e o payload do gatilho, entao o caso comum se escreve direto:
  #
  #     total > 100 and status == 'pago'
  #
  # A saida de um no ja executado vem por `#outputs`, indexada pelo id do no; `#trigger` e o mesmo
  # mapa da raiz, para quem prefere dizer de onde o dado veio:
  #
  #     #outputs['consulta-cliente']['statusCode'] == 200
  #
  # A gramatica aceita e fechada, e conferida na escrita: literais, `and`/`or`/`!`, comparacao,
  # aritmetica, ternario, elvis, leitura de campo e indexacao. Ficam de fora selecao `?[...]`,
  # projecao `![...]`, lista e mapa literais, `matches`, potencia, chamada de metodo, `new`,
  # `T(...)`, `@bean`, funcao e atribuicao -- e tambem qualquer construto que uma versao futura do
  # SpEL venha a introduzir, porque a regra e lista de permissao. Metodo e tipo saem por seguranca
  # (`T(java.lang.Runtime)` seria execucao remota de codigo); selecao, projecao e `matches` saem por
  # custo -- 84 caracteres de selecao aninhada avaliaram por 49 segundos.
  #
  # Uma expressao que nao compila ou que usa construto proibido e BAD_REQUEST na escrita, e nao
  # falha no disparo. Ja o erro de avaliacao -- campo ausente, divisao por zero, resultado que nao e
  # booleano -- e falha do no em tempo de execucao: a condicao que nao pode ser avaliada nunca vira
  # o ramo falso, porque isso faria a execucao parecer que decidiu.
  expression: String

  # Sobra para o que e especifico do no e que o dominio nao precisa inspecionar. O criterio: se o
  # dominio le o campo para validar ou proteger alguma coisa, ele e declarado acima; se e carga
  # opaca repassada adiante, fica aqui.
  config: JSON!

  # As arestas do grafo sao campos de primeira classe, e nunca chaves dentro de `config`: a
  # validacao do grafo (ciclo, aresta orfa, alcancabilidade) so enxerga o que esta declarado aqui,
  # entao uma rota escondida no blob nao tipado passaria por um grafo "validado" carregando um
  # ciclo.
  nextOnSuccess: String
  nextOnTrue: String
  nextOnFalse: String
}

# --- ENUMS ---
enum TriggerType {
  MOCK_EVENT
  SCHEDULE
}

enum NodeType {
  HTTP_REQUEST
  CONDITION
}

# Verbo HTTP do no HTTP_REQUEST. A lista e fechada nos verbos que um passo de workflow precisa:
# CONNECT, TRACE e OPTIONS ficam de fora, e CONNECT em particular transformaria o cliente de saida
# em tunel, que e o que a validacao de destino existe para impedir.
enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

# Os dois enums abaixo nao sao referenciados por nenhum campo enquanto as operacoes de execucao
# estiverem fora do schema. Ficam aqui ja reconciliados com o dominio (ExecutionStatus e StepStatus)
# porque enum sem campo nao mente para ninguem -- nao ha o que resolver -- e o Sprint 3 so precisa
# reintroduzir os tipos que os usam.
enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum StepStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

# --- INPUTS ---
input CreateWorkflowInput {
  name: String!
  description: String
  trigger: TriggerConfigInput!
  nodes: [WorkflowNodeInput!]!
  startNodeId: String
  enabled: Boolean = false
}

# Todo campo e opcional e a distincao entre "nao enviei" e "enviei nulo" e preservada: omitir
# `description` mantem a descricao atual, enviar `description: null` apaga.
input UpdateWorkflowInput {
  name: String
  description: String
  trigger: TriggerConfigInput
  nodes: [WorkflowNodeInput!]
  startNodeId: String
  enabled: Boolean
}

input TriggerConfigInput {
  type: TriggerType!
  config: JSON
}

input WorkflowNodeInput {
  # id do no dentro do workflow; corresponde a WorkflowNode.nodeId no dominio
  id: String!
  type: NodeType!

  # HTTP_REQUEST exige `url` e recusa `expression`; CONDITION exige `expression` e recusa `url`,
  # `method`, `headers` e `body`. A regra e simetrica de proposito: aceitar em silencio o campo que
  # o tipo nao usa deixa o autor convencido de ter configurado algo que nunca sera lido.
  url: String
  method: HttpMethod
  headers: JSON
  body: JSON
  expression: String

  # Opcional: so o que o dominio nao precisa inspecionar. O padrao e um objeto vazio.
  config: JSON = {}

  nextOnSuccess: String
  nextOnTrue: String
  nextOnFalse: String
}
